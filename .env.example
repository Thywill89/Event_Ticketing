# API
PORT=4000

# Supabase Postgres (see apps/api/.env.example for details)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Auth (API) — short-lived access JWT + httpOnly refresh cookie
JWT_ACCESS_SECRET="change-me-to-a-long-random-access-secret"
JWT_REFRESH_PEPPER="change-me-to-a-long-random-refresh-pepper"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
WEB_ORIGIN="http://localhost:3000"
# PUBLIC_WEB_URL=http://localhost:3000

# Order soft-reservation window (minutes). Default 15.
# ORDER_RESERVATION_MINUTES=15

# CRON_SECRET=change-me-long-random
# ORGANIZER_AUTO_APPROVE=true
# EMAIL_TRANSPORT=console
# PUBLIC_WEB_URL=http://localhost:3000

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Paystack (set in apps/api/.env — see docs/PAYMENTS.md)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# ALLOW_STUB_PAYMENTS=true
