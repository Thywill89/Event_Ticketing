// Refresh sessions — opaque tokens hashed at rest (pepper + sha256).
// Raw token is only in an httpOnly cookie; access JWTs stay short-lived.

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  /** sha256(pepper + rawToken) hex */
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  replacedById String?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
