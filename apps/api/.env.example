# Supabase Postgres — Project Settings → Database
#
# DATABASE_URL  = Transaction pooler (port 6543) — used by the app at runtime
# DIRECT_URL    = Direct connection (port 5432) — used by Prisma migrate
#
# Replace [PASSWORD] and [PROJECT-REF] from your Supabase project.

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
PORT=4000

# Auth — short-lived access JWT (Bearer) + rotatable httpOnly refresh cookie.
# Generate long random secrets for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-access-secret"
JWT_REFRESH_PEPPER="change-me-to-a-long-random-refresh-pepper"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
# Legacy fallback if JWT_ACCESS_SECRET is unset:
# JWT_SECRET="change-me-to-a-long-random-secret"
# Web origin for credentialed CORS (comma-separated if multiple)
WEB_ORIGIN="http://localhost:3000"
# COOKIE_SECURE=true
# Optional bcrypt work factor (default 12)
# BCRYPT_COST=12

# Order soft-reservation window in minutes (plan §7.4). Default 15.
# ORDER_RESERVATION_MINUTES=15

# Protect cron-style expire endpoint (recommended in any shared/staging env).
# CRON_SECRET=change-me-long-random

# Organizer approval (plan §11.2). Default: new organizers are PENDING.
# Set true only for local/dev convenience so publish works without admin approve.
# ORGANIZER_AUTO_APPROVE=true

# Notifications (plan §15.1) — default console transport logs emails to API stdout.
# EMAIL_TRANSPORT=console
# EMAIL_TRANSPORT=smtp
# EMAIL_FROM=tickets@example.com
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=
# Absolute links in emails (no trailing slash)
# PUBLIC_WEB_URL=http://localhost:3000

# Local platform admin seed (npm run db:seed-admin)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=Admin123!
# ADMIN_FULL_NAME=Platform Admin

# Payment providers — Paystack (see docs/PAYMENTS.md)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional; defaults to PAYSTACK_SECRET_KEY (Paystack HMAC uses the secret key)
# PAYSTACK_WEBHOOK_SECRET=
# Force stub checkout even when Paystack keys are set (never in production)
# ALLOW_STUB_PAYMENTS=true

# Media: gallery/main image use HTTPS URLs today.
# For production file hosting, configure Supabase Storage (or S3) and paste public URLs
# into the organizer event form. Binary upload API is not required for MVP.
